---
import Layout from "../layouts/Layout.astro";
import Hero from "../components/Hero.astro";
import Icon from "../components/Icon.astro";
import ProjectCard from "../components/ProjectCard.astro";
import AchievementItem from "../components/AchievementItem.astro";
import { getCollection } from "astro:content";
import { site } from "../data/site";

// Content comes from src/content/<section>/*.md — add a file there to add an item.
const visible = <T extends { data: { draft: boolean; order: number } }>(items: T[]) =>
  items.filter((item) => !item.data.draft).sort((a, b) => a.data.order - b.data.order);
const projects = visible(await getCollection("projects"));
const interests = visible(await getCollection("explore"));
const achievements = visible(await getCollection("achievements"));
const projectFilters = ["All work", ...new Set(projects.map((project) => project.data.category))];

const socials = [
  { label: "GitHub", href: site.github },
  { label: "LinkedIn", href: site.linkedin },
].filter(({ href }) => href);
---

<Layout>
  <Hero />

  <section id="projects" class="section projects-section container" aria-labelledby="projects-title">
    <div class="section-heading"><div><p class="eyebrow"><span class="section-number"></span> Projects</p><h2 id="projects-title">Ideas, made real<span class="accent">.</span></h2></div><p>A few things built with intention. And a few ideas for what comes next.</p></div>
    <div class="projects-toolbar"><div class="project-filters" role="group" aria-label="Filter projects" hidden>{projectFilters.map((filter, index) => <button type="button" data-filter={filter} aria-pressed={index === 0}>{filter}<span>{filter === "All work" ? projects.length : projects.filter((project) => project.data.category === filter).length}</span></button>)}</div><p class="project-count" aria-live="polite" aria-atomic="true">{projects.length} {projects.length === 1 ? "project" : "projects"} to explore</p></div>
    <div class="project-grid">{projects.map((project, index) => <ProjectCard project={project} index={index} />)}</div>
  </section>

  <section id="explore" class="explore-section" aria-labelledby="explore-title">
    <div class="container section">
      <div class="section-heading"><div><p class="eyebrow"><span class="section-number"></span>Beyond the projects</p><h2 id="explore-title">Follow the curiosity<span>.</span></h2></div><p>Interests, rabbit holes, and the things that keep me asking “what if?”</p></div>
      <div class="interests-grid">{interests.map((interest, index) => <article class="interest-card"><div class="interest-top"><Icon name={interest.data.icon} size={29} /><span>{String(index + 1).padStart(2, "0")}</span></div><h3>{interest.data.title}</h3><p>{interest.body?.trim()}</p>{interest.data.note && <span class="interest-note">{interest.data.note}<Icon name="diagonal" size={15} /></span>}</article>)}</div>
      <div class="explore-footnote"><span class="small-star">✳</span><p>{site.about}</p><span class="handwritten">Still figuring things out.<br />Enjoying the process.</span></div>
    </div>
  </section>

  <section id="achievements" class="section achievements-section container" aria-labelledby="achievements-title">
    <div class="section-heading"><div><p class="eyebrow"><span class="section-number"></span></p><h2 id="achievements-title">Little wins. Big steps<span class="accent">.</span></h2></div><p>A growing collection of milestones. There’s more of the story to come.</p></div>
    <div class="achievement-list">{achievements.map((achievement) => <AchievementItem achievement={achievement} />)}</div>
  </section>

  <section id="connect" class="connect-section container" aria-labelledby="connect-title">
    <div class="connect-panel">
      <div class="connect-top"><span class="eyebrow"><span class="section-number"></span> Open to a conversation</span><span class="connect-spark" aria-hidden="true">✳</span></div>
      <h2 id="connect-title">Good things start<br />with a <span>hello.</span></h2>
      <div class="connect-bottom">
        <p>Have an idea, a question, or just want to say hi?<br />I’d love to hear from you.</p>
        <div class="contact-actions">
          {site.email && <a class="email-link" href={`mailto:${site.email}`}><Icon name="mail" size={20} /><span>{site.email}</span></a>}
          {socials.map(({ label, href }) => <a href={href} target="_blank" rel="noopener noreferrer">{label === "LinkedIn" && <Icon name="linkedin" size={20} />}<span>{label}</span></a>)}
          {!site.email && socials.length === 0 && <span class="contact-coming-soon"><Icon name="mail" size={19} />Contact details coming soon</span>}
        </div>
      </div>
    </div>
  </section>
</Layout>
