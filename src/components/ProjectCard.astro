---
import type { Project } from "../data/site";

const { title, description, tags, repo, demo } = Astro.props as Project;
---

<article class="grid gap-3 border-t border-line py-8 md:grid-cols-[1fr_2fr] md:gap-10">
  <h3 class="font-display text-2xl font-bold">{title}</h3>
  <div>
    <p class="max-w-prose">{description}</p>
    <ul class="mt-3 flex flex-wrap gap-2 text-sm text-muted">
      {tags.map((tag) => <li class="rounded-full border border-line px-3 py-0.5">{tag}</li>)}
    </ul>
    <p class="mt-4 flex gap-5 text-sm font-medium">
      {demo && <a href={demo} class="text-accent underline underline-offset-4">Live demo</a>}
      {repo && <a href={repo} class="text-accent underline underline-offset-4">Source code</a>}
    </p>
  </div>
</article>
