---
import type { Project } from "../data/site";
import Icon from "./Icon.astro";
import ProjectArtwork from "./ProjectArtwork.astro";

interface Props extends Project { index: number; }
const { id, title, description, details, category, tags, artwork, sample, repo, demo, index } = Astro.props;
---

<article class="project-card" data-category={category}>
  <button class="project-image-button" type="button" data-project-open={`project-${id}`} aria-label={`Read about ${title}`} aria-haspopup="dialog">
    <ProjectArtwork kind={artwork} />
    <span class="project-image-link"><Icon name="diagonal" size={22} /></span>
    {sample && <span class="sample-label">Sample concept</span>}
  </button>
  <div class="project-meta"><span>{String(index + 1).padStart(2, "0")} / {category}</span><span>{tags[0]}</span></div>
  <h3><button type="button" data-project-open={`project-${id}`} aria-haspopup="dialog">{title}<Icon name="diagonal" size={22} /></button></h3>
  <p>{description}</p>
  <ul class="project-tags" aria-label="Technologies and topics">{tags.map((tag) => <li>{tag}</li>)}</ul>
</article>

<dialog class="project-dialog" id={`project-${id}`} aria-labelledby={`title-${id}`}>
  <button type="button" class="dialog-close icon-button" data-dialog-close aria-label="Close project details"><Icon name="close" /></button>
  <ProjectArtwork kind={artwork} />
  <div class="dialog-content">
    <p class="eyebrow">{sample ? "Sample project concept" : "Behind the project"}</p>
    <h2 id={`title-${id}`}>{title}</h2>
    <p>{details}</p>
    <ul class="project-tags" aria-label="Technologies and topics">{tags.map((tag) => <li>{tag}</li>)}</ul>
    {(demo || repo) && <div class="dialog-links">
      {demo && <a class="button button-dark" href={demo} target="_blank" rel="noopener noreferrer">Live project<Icon name="diagonal" size={17} /></a>}
      {repo && <a class="text-link" href={repo} target="_blank" rel="noopener noreferrer">Source code<Icon name="diagonal" size={17} /></a>}
    </div>}
  </div>
</dialog>
