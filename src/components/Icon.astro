---
interface Props {
  name: string;
  size?: number;
  class?: string;
}

const { name, size = 20, class: className } = Astro.props;
const paths: Record<string, string[]> = {
  arrow: ["M5 12h14", "m13 6 6 6-6 6"],
  diagonal: ["M6 18 18 6", "M6 6h12v12"],
  down: ["M12 4v16", "m6 14 6 6 6-6"],
  code: ["m8 6-6 6 6 6", "m16 6 6 6-6 6", "m14 3-4 18"],
  sparkles: ["m12 3 2.5 6.5L21 12l-6.5 2.5L12 21l-2.5-6.5L3 12l6.5-2.5L12 3Z", "M20 2v4", "M18 4h4"],
  compass: ["M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z", "m16 8-2.5 5.5L8 16l2.5-5.5L16 8Z"],
  trophy: ["M8 3h8v6a4 4 0 0 1-8 0V3Z", "M8 5H4v3a4 4 0 0 0 4 4", "M16 5h4v3a4 4 0 0 1-4 4", "M12 13v7", "M8 21h8"],
  award: ["M17 8a5 5 0 1 1-10 0 5 5 0 0 1 10 0Z", "m8 12-1 9 5-3 5 3-1-9"],
  people: ["M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2", "M13 7a4 4 0 1 1-8 0 4 4 0 0 1 8 0Z", "M22 21v-2a4 4 0 0 0-3-3.87", "M16 3.13a4 4 0 0 1 0 7.75"],
  mail: ["M3 5h18v14H3V5Z", "m3 6 9 7 9-7"],
  copy: ["M9 9h12v12H9V9Z", "M15 9V3H3v12h6"],
  close: ["m6 6 12 12", "M6 18 18 6"],
  menu: ["M4 8h16", "M4 16h16"],
};
---

<svg width={size} height={size} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class={className} aria-hidden="true">
  {(paths[name] ?? paths.arrow).map((d) => <path d={d} />)}
</svg>
