---
import { Image } from "astro:assets";
import type { CollectionEntry } from "astro:content";
import Icon from "./Icon.astro";

interface Props { achievement: CollectionEntry<"achievements">; }
const { achievement: { id, data } } = Astro.props;
---

<section class="achievement-gallery" aria-label={data.title}>
  <div class="gallery-grid">
    {data.gallery.map((item, index) => (
      <figure>
        <div class="gallery-photo">
          {item.image ? (
            <button class="gallery-photo-button" type="button" data-photo-open={`photo-${id}-${index}`} aria-label={`View photo: ${item.title}`} aria-haspopup="dialog" aria-controls={`photo-${id}-${index}`}>
              <Image src={item.image} alt={item.imageAlt ?? item.title} widths={[480, 800, 1200]} sizes="(max-width: 520px) 100vw, (max-width: 760px) 50vw, 360px" loading="lazy" />
            </button>
          ) : (
            <div class="photo-placeholder">
              <Icon name={data.icon} size={36} />
              <span>Competition photo</span>
            </div>
          )}
        </div>
        <figcaption>
          <h4>{item.title}</h4>
          <p>{item.caption}</p>
        </figcaption>
        {item.image && (
          <dialog class="photo-dialog" id={`photo-${id}-${index}`} aria-labelledby={`photo-title-${id}-${index}`}>
            <div class="photo-dialog-header">
              <h3 id={`photo-title-${id}-${index}`}>{item.title}</h3>
              <button type="button" class="photo-close" data-photo-close aria-label="Close photo" autofocus><Icon name="close" size={20} /></button>
            </div>
            <Image class="photo-preview" src={item.image} alt={item.imageAlt ?? item.title} widths={[480, 800, 1200]} sizes="(max-width: 632px) calc(100vw - 64px), 568px" loading="lazy" />
            <p class="photo-caption">{item.caption}</p>
          </dialog>
        )}
      </figure>
    ))}
  </div>
</section>

<script>
  document.querySelectorAll<HTMLButtonElement>("[data-photo-open]").forEach((button) => {
    button.addEventListener("click", () => {
      const dialog = document.getElementById(button.dataset.photoOpen ?? "");
      if (dialog instanceof HTMLDialogElement) {
        dialog.showModal();
        document.body.classList.add("dialog-open");
      }
    });
  });

  document.querySelectorAll<HTMLDialogElement>(".photo-dialog").forEach((dialog) => {
    dialog.querySelector<HTMLButtonElement>("[data-photo-close]")?.addEventListener("click", () => dialog.close());
    dialog.addEventListener("close", () => document.body.classList.remove("dialog-open"));
    dialog.addEventListener("click", (event) => {
      if (event.target !== dialog) return;
      const bounds = dialog.getBoundingClientRect();
      if (event.clientX < bounds.left || event.clientX > bounds.right || event.clientY < bounds.top || event.clientY > bounds.bottom) dialog.close();
    });
  });
</script>

<style>
  .gallery-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 24px; max-width: 1110px; }
  figure { margin: 0; min-width: 0; }
  .gallery-photo { aspect-ratio: 3 / 2; overflow: hidden; border-radius: 5px; background: #e6e9da; }
  .gallery-photo img { display: block; width: 100%; height: 100%; object-fit: cover; }
  .gallery-photo-button { position: relative; display: block; width: 100%; height: 100%; padding: 0; background: transparent; cursor: pointer; }
  .gallery-photo-button:focus-visible { outline-offset: -5px; }
  .photo-dialog { position: fixed; inset: 0; width: min(600px, calc(100% - 32px)); max-height: calc(100dvh - 32px); margin: auto; padding: 16px; border: 1px solid var(--color-line); border-radius: 9px; background: var(--color-paper); color: var(--color-ink); box-shadow: 0 25px 100px #10211740; overscroll-behavior: contain; }
  .photo-dialog::backdrop { background: rgb(20 35 23 / 65%); backdrop-filter: blur(5px); }
  .photo-dialog-header { display: flex; align-items: center; justify-content: space-between; gap: 16px; margin-bottom: 16px; }
  .photo-dialog-header h3 { font-size: 1.125rem; font-weight: 500; line-height: 1.4; }
  .photo-close { display: grid; place-items: center; flex-shrink: 0; width: 40px; height: 40px; border-radius: 50%; background: #e6e9da; }
  .photo-close:hover { background: #dce2cd; }
  .photo-preview { display: block; width: 100%; height: auto; max-height: min(60dvh, 480px); object-fit: contain; border-radius: 4px; }
  .photo-caption { margin-top: 12px; font-size: 1rem; color: var(--color-muted); }
  .photo-placeholder { display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 14px; height: 100%; color: #65734e; }
  .photo-placeholder span { font-size: .875rem; }
  figcaption { padding-top: 16px; }
  h4 { margin: 0 0 6px; font-size: 22px; font-weight: 500; letter-spacing: -.025em; }
  figcaption p { font-size: 1rem; line-height: 1.6; color: var(--color-muted); }
  @media (max-width: 760px) {
    .gallery-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (max-width: 520px) {
    .gallery-grid { grid-template-columns: 1fr; gap: 30px; max-width: 320px; }
  }
</style>
