---
import "../styles/global.css";
import Icon from "../components/Icon.astro";
import { site, navigation } from "../data/site";

interface Props { title?: string; description?: string; }
const { title = `${site.name} — Developer & curious human`, description = site.intro } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f7f7f0" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <link rel="icon" type="image/svg+xml" href={`${import.meta.env.BASE_URL}favicon.svg`} />
    <title>{title}</title>
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <header class="site-header">
      <div class="container header-inner">
        <a href="#home" class="wordmark" aria-label={`${site.name}, home`}>{site.initials}<span></span></a>
        <nav class="desktop-nav" aria-label="Main navigation">
          {navigation.map(({ label, href }, i) => <a href={href} class:list={["nav-link", { "nav-connect": href === "#connect" }]} aria-current={i === 0 ? "location" : undefined}>{label}{href === "#connect" && <Icon name="diagonal" size={16} />}</a>)}
        </nav>
        <details class="mobile-menu">
          <summary>Menu<Icon name="menu" size={22} /></summary>
          <nav aria-label="Mobile navigation">
            {navigation.map(({ label, href }, i) => <a href={href} class="nav-link" aria-current={i === 0 ? "location" : undefined}><span>{label}</span><Icon name="diagonal" size={18} /></a>)}
          </nav>
        </details>
      </div>
    </header>
    <main id="main-content"><slot /></main>
    <footer class="site-footer container">
      <a href="#home" class="wordmark" aria-label="Back to home">{site.initials}<span>✳</span></a>
      <p>© {new Date().getFullYear()} {site.name}</p>
      <a href="#home" class="back-to-top">Back to top<Icon name="arrow" size={17} /></a>
    </footer>
    <script src="../scripts/portfolio.ts"></script>
  </body>
</html>
